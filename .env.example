# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Which city this deployment serves (row in public.cities)
NEXT_PUBLIC_CITY=kirkuk
# Optional: shown on the pricing page ("contact us on WhatsApp"), international format without +
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Web Push (generate with: node scripts/generate-vapid.mjs). Push UI is hidden until the public key is set.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for POST /api/push/dispatch (header x-push-secret)
PUSH_DISPATCH_SECRET=
